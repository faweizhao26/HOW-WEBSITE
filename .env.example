NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_CONTENT_MODE=supabase

# Optional CI publication journey, isolated test project only.
# The app build must point to this same project.
PUBLICATION_TEST_SUPABASE_URL=
PUBLICATION_TEST_SUPABASE_ANON_KEY=
PUBLICATION_TEST_SUPABASE_SERVICE_ROLE_KEY=
PUBLICATION_TEST_ADMIN_EMAIL=
PUBLICATION_TEST_ADMIN_PASSWORD=
PUBLICATION_TEST_ISOLATED_PROJECT=false

# Reuse an existing ego-lite TaskSpace for local visual verification.
EGO_TASK_SPACE_ID=
EGO_BASE_URL=http://127.0.0.1:3018
